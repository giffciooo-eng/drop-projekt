{%- comment -%} Usnij: strona produktu (galeria, kolor, zestaw, koszyk, zakładki, sekcje sprzedażowe, przyklejony pasek). {%- endcomment -%}
{{ 'usnij.css' | asset_url | stylesheet_tag }}
{%- assign p = product -%}
{%- assign v0 = p.selected_or_first_available_variant -%}
{%- assign start_media = v0.featured_media | default: p.featured_media -%}
{%- comment -%} Zestaw = liczba sztuk tego samego koloru. Cena 2 sztuk = 2 × cena − rabat automatyczny „2 maski za 199 zł” (79 zł). {%- endcomment -%}
{%- assign rabat2 = 7900 -%}
{%- assign cena1 = v0.price -%}
{%- assign cena2 = v0.price | times: 2 | minus: rabat2 -%}
<div class="usnij" data-usnij-pdp>
<div class="wrap pdp">
  <div class="gal">
    <div class="gal-main">
      {%- if start_media -%}
        <img data-gal-main src="{{ start_media | image_url: width: 1200 }}" alt="{{ start_media.alt | escape }}" width="1200" height="1200" fetchpriority="high">
      {%- endif -%}
    </div>
    <div class="thumbs">
      {%- for m in p.media -%}
        {%- if m.media_type == 'image' -%}
          <button type="button" class="thumb" data-media-id="{{ m.id }}" data-src="{{ m | image_url: width: 1200 }}" aria-current="{% if m.id == start_media.id %}true{% else %}false{% endif %}" aria-label="{{ m.alt | escape }}">
            <img src="{{ m | image_url: width: 200 }}" alt="{{ m.alt | escape }}" width="200" height="200" loading="lazy">
          </button>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  <div class="buy">
    <h1>{{ p.title }}</h1>
    <p class="lead" style="margin-bottom:.4em">Ciemność i delikatny ciężar na powiekach, dzięki którym łatwiej się wyciszyć przed snem.</p>

    {%- form 'product', p, id: 'usnij-form', novalidate: 'novalidate' -%}
      <input type="hidden" name="id" value="{{ v0.id }}" data-variant-input>
      <input type="hidden" name="quantity" value="2" data-qty-input>

      <div class="label">Kolor: <span data-color-name>{{ v0.option1 }}</span></div>
      <div class="swatches">
        {%- for val in p.options_with_values[0].values -%}
          {%- case val -%}
            {%- when 'Czarny' -%}{%- assign hex = '#1d1d22' -%}
            {%- when 'Szary' -%}{%- assign hex = '#9b9ca3' -%}
            {%- when 'Różowy' -%}{%- assign hex = '#e8b8c4' -%}
            {%- else -%}{%- assign hex = '#cccccc' -%}
          {%- endcase -%}
          <button type="button" class="sw" data-value="{{ val | escape }}" aria-pressed="{% if val == v0.option1 %}true{% else %}false{% endif %}"><i style="background:{{ hex }}"></i>{{ val }}</button>
        {%- endfor -%}
      </div>

      <div class="label">Zestaw</div>
      <div class="sets">
        <button type="button" class="set" data-qty="1" aria-pressed="false">
          <span><span class="t">1 maska</span><br><span class="s">+ 12,99 zł dostawa</span></span>
          <span class="p">{{ cena1 | money_without_trailing_zeros }}</span>
        </button>
        <button type="button" class="set" data-qty="2" aria-pressed="true">
          <span class="badge">Taniej na sztukę</span>
          <span><span class="t">2 maski</span><br><span class="s">99,50 zł za sztukę · oszczędzasz 79 zł · darmowa dostawa</span></span>
          <span class="p">{{ cena2 | money_without_trailing_zeros }}</span>
        </button>
      </div>
      <p class="small" style="margin-top:6px">2 maski w wybranym kolorze. Chcesz dwa różne kolory? Dodaj do koszyka każdą maskę osobno, a cena 199 zł za dwie naliczy się sama w koszyku.</p>

      <div class="pricebox"><span class="price" data-price>{{ cena2 | money_without_trailing_zeros }}</span><span class="ship" data-ship></span></div>
      <p class="small">Razem z dostawą: <b data-total></b></p>
      <button type="submit" class="btn block" id="main-atc" data-atc {% unless v0.available %}disabled{% endunless %}><span data-atc-label>Dodaj do koszyka</span></button>
    {%- endform -%}

    <div class="mini-trust">
      <span><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h11v9H3zM14 9h4l3 3v3h-7"/><circle cx="7" cy="17" r="2"/><circle cx="17" cy="17" r="2"/></svg>Dostawa 8–18 dni z numerem śledzenia</span>
      <span><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 12a8 8 0 1 0 3-6.2"/><path d="M4 4v4h4"/></svg>30 dni na zwrot bez podawania przyczyny</span>
      <span><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="6" width="18" height="12" rx="2"/><path d="M3 10h18"/></svg>BLIK, karta, szybki przelew</span>
    </div>

    <div style="margin-top:18px">
      <details open><summary>Opis</summary><div class="in">{{ p.description }}</div></details>
      <details><summary>Co jest w zestawie</summary><div class="in"><ul><li>1 maska: 1 × obciążeniowa maska na oczy</li><li>2 maski: 2 × obciążeniowa maska na oczy w wybranym kolorze (różne kolory: dodaj każdą maskę osobno)</li></ul></div></details>
      <details><summary>Wymiary</summary><div class="in"><ul><li>Długość i szerokość: ok. 70 × 12 cm (wg opisu dostawcy)</li><li>Materiał: podwójny polar, wypełnienie: szklane kulki w 4 komorach</li><li>Na jednym końcu otwór do przepięcia maski z tyłu głowy</li></ul></div></details>
      <details><summary>Dostawa i zwroty</summary><div class="in"><ul><li>Dostawa 8–18 dni: 1–3 dni przygotowania + 7–15 dni transportu, z numerem śledzenia</li><li>Darmowa od 199 zł, poniżej 12,99 zł</li><li>Cena końcowa, bez cła i dopłat przy odbiorze</li><li>30 dni na zwrot bez podawania przyczyny</li><li>Paczka nie dotarła w 25 dni od nadania: nowa albo zwrot pieniędzy</li></ul></div></details>
    </div>
  </div>
</div>

<section class="dark"><div class="wrap benefit">
  <img src="{{ 'usnij-para-lampka.jpg' | file_url }}" alt="Kobieta śpi z czarną maską Usnij na oczach, a obok partner czyta przy zapalonej lampce" style="border-radius:14px" loading="lazy" width="1200" height="1500">
  <div>
    <h2>Ciężar, który uspokaja, zamiast uciskać</h2>
    <ul class="ticks">
      <li><span><b>Ciemność.</b> Maska przykrywa oczy i czoło, więc lampka partnera czy ekran telefonu obok nie świecą Ci w oczy.</span></li>
      <li><span><b>Równy, delikatny ciężar.</b> Szklane kulki w 4 komorach leżą na powiekach płasko, bez jednego punktu nacisku.</span></li>
      <li><span><b>Bez gumki.</b> Końce kładziesz na poduszce albo przepinasz z tyłu głowy. Nic nie ciągnie za włosy.</span></li>
    </ul>
  </div>
</div></section>

<section><div class="wrap">
  <h2 class="center">Co wyróżnia maskę Usnij</h2>
  <div class="features">
    <div class="feat"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="7" cy="9" r="2.2"/><circle cx="12" cy="7" r="2.2"/><circle cx="17" cy="9" r="2.2"/><circle cx="9.5" cy="14" r="2.2"/><circle cx="14.5" cy="14" r="2.2"/></svg><h3>Szklane kulki</h3><p>Wypełnienie ze szklanych kulek daje równy, przyjemny ciężar.</p></div>
    <div class="feat"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="2" y="8" width="20" height="8" rx="4"/><path d="M7 8v8M12 8v8M17 8v8"/></svg><h3>4 komory</h3><p>Kulki się nie przesypują w jeden róg. Ciężar zostaje tam, gdzie trzeba.</p></div>
    <div class="feat"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 11c2-4.5 14-4.5 16 0v2c-2 3.5-14 3.5-16 0z"/><path d="M12 7v10"/></svg><h3>Oczy i czoło</h3><p>Maska przykrywa całą okolicę oczu i czoło, a nie tylko powieki.</p></div>
    <div class="feat"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 12h18"/><path d="M6 8l-3 4 3 4M18 8l3 4-3 4"/></svg><h3>Końce bez wypełnienia</h3><p>Leżą płasko na poduszce albo pod głową. Bez gumki.</p></div>
    <div class="feat"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 3l9 5-9 5-9-5z"/><path d="M3 13l9 5 9-5"/></svg><h3>Podwójny polar</h3><p>Miękki i przyjemny dla skóry, ciepły w zimowe wieczory.</p></div>
    <div class="feat"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 12c0-4 3.5-7 8-7s8 3 8 7"/><path d="M9 15l3-3 3 3"/><path d="M8 19c2-2.5 6-2.5 8 0"/></svg><h3>Przepinana z tyłu</h3><p>Jeden koniec przekładasz przez otwór w drugim i maska jest zapięta wokół głowy.</p></div>
  </div>
</div></section>

<section class="alt"><div class="wrap">
  <h2 class="center">Z bliska</h2>
  <div class="closeups">
    <figure><img src="{{ 'usnij-makro-srodek.jpg' | file_url }}" alt="Zbliżenie marszczonego środka maski między dwiema wypełnionymi komorami" style="border-radius:14px;aspect-ratio:1/1;object-fit:cover" loading="lazy" width="1000" height="1000"><figcaption>Wypełnione komory nad oczami</figcaption></figure>
    <figure><img src="{{ 'usnij-makro-polar.jpg' | file_url }}" alt="Palec delikatnie wciska się w miękki polar maski" style="border-radius:14px;aspect-ratio:1/1;object-fit:cover" loading="lazy" width="1000" height="1000"><figcaption>Miękki, podwójny polar</figcaption></figure>
    <figure><img src="{{ 'usnij-makro-koniec.jpg' | file_url }}" alt="Płaski koniec maski bez wypełnienia leży na poduszce" style="border-radius:14px;aspect-ratio:1/1;object-fit:cover" loading="lazy" width="1000" height="1000"><figcaption>Płaskie końce bez wypełnienia</figcaption></figure>
  </div>
</div></section>

<section><div class="wrap">
  <h2 class="center">Zamiast zwykłej maski do spania</h2>
  <table class="compare">
    <tr><th></th><th>Zwykła maska</th><th>Usnij</th></tr>
    <tr><td>Wypełnienie</td><td>pianka lub sama tkanina</td><td>szklane kulki w 4 komorach</td></tr>
    <tr><td>Co przykrywa</td><td>same oczy</td><td>oczy i czoło</td></tr>
    <tr><td>Mocowanie</td><td>gumka za głową</td><td>końce na poduszce albo przepięte z tyłu, bez gumki</td></tr>
  </table>
</div></section>

<section class="dark"><div class="wrap gift">
  <img src="{{ 'usnij-prezent-2-maski.jpg' | file_url }}" alt="Szara i czarna maska Usnij w otwartym pudełku prezentowym z granatową wstążką" style="border-radius:14px" loading="lazy" width="1200" height="1500">
  <div>
    <h2>Dwie maski: dla Ciebie i na prezent</h2>
    <p class="lead">Dla mamy, żony, przyjaciółki, dla każdego, kto mówi „znowu nie spałam”.</p>
    <p><b style="color:#e2a355;font-size:1.3rem">2 maski za 199 zł</b> · darmowa dostawa · oszczędzasz 79 zł</p>
    <p class="note">Dostawa trwa 8–18 dni (czas podany przez dostawcę). Na święta zamów z wyprzedzeniem.</p>
    <button type="button" class="btn" data-pick-qty="2">Wybieram 2 maski</button>
  </div>
</div></section>

<section class="alt" id="faq"><div class="wrap">
  <h2 class="center">Pytania i odpowiedzi</h2>
  <details><summary>Ile trwa dostawa?</summary><div class="in">8 do 18 dni od zamówienia (1–3 dni przygotowania i 7–15 dni transportu), z numerem śledzenia. Jeśli paczka nie dotrze w ciągu 25 dni od nadania, wysyłamy nową albo oddajemy pieniądze.</div></details>
  <details><summary>Czy maska nie będzie za ciężka?</summary><div class="in">Ciężar rozkłada się na 4 komory, więc nie uciska jednego punktu. Jeśli Ci nie posłuży, masz 30 dni na zwrot.</div></details>
  <details><summary>Czy zsunie się w nocy?</summary><div class="in">Końce bez wypełnienia leżą płasko na poduszce albo pod głową. Jeśli śpisz niespokojnie, przepnij maskę z tyłu głowy: jeden koniec przełóż przez otwór w drugim.</div></details>
  <details><summary>Czy mogę spać na boku?</summary><div class="in">Tak. Przepnij maskę z tyłu głowy (jeden koniec przez otwór w drugim), wtedy jest zapięta wokół głowy, bez gumki.</div></details>
  <details><summary>Czy to leczy bezsenność?</summary><div class="in">Nie, to nie jest wyrób medyczny. Daje ciemność i delikatny ciężar, co wielu osobom pomaga się wyciszyć.</div></details>
  <details><summary>Jak zapłacę?</summary><div class="in">BLIK, kartą albo szybkim przelewem. Cena jest końcowa, bez dopłat przy odbiorze.</div></details>
</div></section>

<section id="opinie"><div class="wrap">
  <h2 class="center">Opinie o masce</h2>
  <p class="small center" style="max-width:720px;margin:0 auto 18px">Część opinii poniżej pochodzi od osób, które kupiły tę samą maskę w serwisie AliExpress, i została do nas zaimportowana. Nie sprawdzamy, czy autorzy tych opinii kupili maskę w sklepie Usnij. Opinie klientów sklepu Usnij są oznaczone jako zweryfikowany zakup. Pokazujemy wszystkie zaimportowane oceny, także niższe.</p>
  <div id="looxReviews" data-product-id="{{ product.id }}" class="loox-reviews-default">{{ product.metafields.loox.reviews }}</div>
</div></section>

<div class="sticky" aria-hidden="true"><div class="wrap">
  <div class="info"><b><span data-set-name>2 maski</span> · <span data-color-name>{{ v0.option1 }}</span></b><span data-ship></span></div>
  <button type="button" class="btn" data-atc data-sticky-atc><span data-price>{{ cena2 | money_without_trailing_zeros }}</span> · Do koszyka</button>
</div></div>
</div>

<script type="application/json" id="usnij-product-json">{{ p | json }}</script>
<script>
(function () {
  var root = document.querySelector('[data-usnij-pdp]');
  if (!root) return;
  var P = JSON.parse(document.getElementById('usnij-product-json').textContent);
  var RABAT = {{ rabat2 }};
  var vIn = root.querySelector('[data-variant-input]'), qIn = root.querySelector('[data-qty-input]');
  var start = P.variants.find(function (v) { return String(v.id) === vIn.value; }) || P.variants[0];
  var kolor = start.option1, qty = 2;
  function zl(c) { var z = c / 100; return (Number.isInteger(z) ? String(z) : z.toFixed(2).replace('.', ',')) + ' zł'; }
  function biezacy() { return P.variants.find(function (v) { return v.option1 === kolor; }); }
  function cena(v) { return qty === 2 ? v.price * 2 - RABAT : v.price; }
  function each(q, f) { root.querySelectorAll(q).forEach(f); }
  function zdjecie(src, id) {
    var m = root.querySelector('[data-gal-main]');
    if (m && src) { m.src = src; }
    each('.thumb', function (t) { t.setAttribute('aria-current', String(String(t.dataset.mediaId) === String(id))); });
  }
  function render() {
    var v = biezacy(); if (!v) return;
    vIn.value = v.id; qIn.value = qty;
    var c = cena(v), darmowa = c >= 19900, dostawa = darmowa ? 0 : 1299;
    each('[data-price]', function (e) { e.textContent = zl(c); });
    each('[data-ship]', function (e) { e.textContent = darmowa ? 'Darmowa dostawa' : '+ ' + zl(dostawa) + ' dostawa'; e.classList.toggle('free', darmowa); });
    each('[data-total]', function (e) { e.textContent = zl(c + dostawa); });
    each('[data-color-name]', function (e) { e.textContent = kolor; });
    each('[data-set-name]', function (e) { e.textContent = qty === 2 ? '2 maski' : '1 maska'; });
    each('[data-atc-label]', function (e) { e.textContent = (v.available ? 'Dodaj do koszyka · ' : 'Chwilowo niedostępne · ') + zl(c); });
    each('[data-atc]', function (b) { b.disabled = !v.available; });
    each('.sw', function (b) { b.setAttribute('aria-pressed', String(b.dataset.value === kolor)); });
    each('.set', function (b) { b.setAttribute('aria-pressed', String(Number(b.dataset.qty) === qty)); });
    try { var u = new URL(location.href); u.searchParams.set('variant', v.id); history.replaceState(null, '', u); } catch (e) {}
  }
  root.addEventListener('click', function (e) {
    var sw = e.target.closest('.sw');
    if (sw) {
      kolor = sw.dataset.value; render();
      var v = biezacy();
      if (v && v.featured_media && v.featured_media.preview_image) {
        var s = v.featured_media.preview_image.src; s += (s.indexOf('?') > -1 ? '&' : '?') + 'width=1200';
        zdjecie(s, v.featured_media.id);
      }
    }
    var st = e.target.closest('.set'); if (st) { qty = Number(st.dataset.qty); render(); }
    var th = e.target.closest('.thumb'); if (th) { zdjecie(th.dataset.src, th.dataset.mediaId); }
    var pk = e.target.closest('[data-pick-qty]');
    if (pk) { qty = Number(pk.dataset.pickQty); render(); root.querySelector('.buy').scrollIntoView({ behavior: 'smooth', block: 'start' }); }
    var sb = e.target.closest('[data-sticky-atc]');
    if (sb) { var f = document.getElementById('usnij-form'); if (f.requestSubmit) f.requestSubmit(); else f.submit(); }
  });
  var atc = root.querySelector('#main-atc'), sticky = root.querySelector('.sticky');
  if (atc && sticky) {
    var spr = function () { sticky.classList.toggle('show', atc.getBoundingClientRect().bottom < 0); };
    window.addEventListener('scroll', spr, { passive: true }); window.addEventListener('resize', spr); spr();
  }
  render();
})();
</script>

{% schema %}
{
  "name": "Usnij: strona produktu",
  "settings": []
}
{% endschema %}
